NODE_ENV="development"
PORT="3000"
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
CORS_ORIGIN="http://localhost:8081"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Progress photos (S3-compatible). Development: the RustFS container from
# docker-compose. Production: Cloudflare R2 (S3_REGION="auto", no path style).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="pepfit"
S3_SECRET_ACCESS_KEY="pepfit-dev-secret"
S3_BUCKET="pep-fit-photos"
S3_FORCE_PATH_STYLE="true"
S3_AUTO_SETUP="true"
