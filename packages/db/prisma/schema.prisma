generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  clerkId             String           @unique
  email               String           @unique
  alias               String?
  avatarUrl           String?
  targetWeight        Float?
  experienceLevel     ExperienceLevel?
  goal                Goal?
  onboardingCompleted Boolean          @default(false)
  /// The routine the user is currently following (at most one).
  activeRoutineId     String?          @unique
  activeRoutine       Routine?         @relation("ActiveRoutine", fields: [activeRoutineId], references: [id], onDelete: SetNull)
  routines            Routine[]        @relation("RoutineOwner")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("users")
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum Goal {
  build_muscle
  lose_weight
  maintenance
  strength
}

model Exercise {
  id                String       @id @default(uuid())
  /// Canonical English name from free-exercise-db; the seed upserts by it.
  name              String       @unique
  primaryMuscle     MuscleGroup
  secondaryMuscles  MuscleGroup[]
  equipment         Equipment?
  category          ExerciseCategory
  imageUrls         String[]
  translations      ExerciseTranslation[]
  routineExercises  RoutineExercise[]

  @@map("exercises")
}

/// Localized exercise names. `Exercise.name` stays as the canonical English
/// name from free-exercise-db; every exercise has one row per supported locale.
model ExerciseTranslation {
  id         String   @id @default(uuid())
  exerciseId String
  locale     Locale
  /// Collated with ICU in the migration so accents/case sort naturally.
  name       String
  /// `name` lowercased and without accents, for accent-insensitive search.
  searchName String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, locale])
  @@index([locale, name])
  @@map("exercise_translations")
}

enum Locale {
  es
  en
}

enum MuscleGroup {
  abdominals
  abductors
  adductors
  biceps
  calves
  chest
  forearms
  glutes
  hamstrings
  lats
  lower_back
  middle_back
  neck
  quadriceps
  shoulders
  traps
  triceps
}

enum Equipment {
  barbell
  dumbbell
  kettlebells
  machine
  cable
  body_only
  bands
  medicine_ball
  exercise_ball
  foam_roll
  e_z_curl_bar
  other
}

enum ExerciseCategory {
  strength
  stretching
  plyometrics
  strongman
  powerlifting
  cardio
  olympic_weightlifting
}

model Routine {
  id          String       @id @default(uuid())
  userId      String
  name        String
  user        User         @relation("RoutineOwner", fields: [userId], references: [id], onDelete: Cascade)
  activeFor   User?        @relation("ActiveRoutine")
  days        RoutineDay[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@map("routines")
}

model RoutineDay {
  id        String            @id @default(uuid())
  routineId String
  /// 0-based position inside the routine.
  position  Int
  name      String
  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@unique([routineId, position])
  @@map("routine_days")
}

model RoutineExercise {
  id          String       @id @default(uuid())
  dayId       String
  exerciseId  String
  position    Int
  restSeconds Int
  day         RoutineDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// Restrict: catalog exercises in use by a routine must never be deleted.
  exercise    Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets        RoutineSet[]

  @@unique([dayId, position])
  @@map("routine_exercises")
}

/// A planned set. Every set is its own row so routines can vary reps/weight
/// per set (pyramids, top sets + back-offs...).
model RoutineSet {
  id                String          @id @default(uuid())
  routineExerciseId String
  position          Int
  targetReps        Int?
  targetWeightKg    Float?
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@unique([routineExerciseId, position])
  @@map("routine_sets")
}
