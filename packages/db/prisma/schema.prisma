generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  clerkId             String           @unique
  email               String           @unique
  alias               String?
  avatarUrl           String?
  targetWeight        Float?
  experienceLevel     ExperienceLevel?
  goal                Goal?
  onboardingCompleted Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("users")
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum Goal {
  build_muscle
  lose_weight
  maintenance
  strength
}

model Exercise {
  id                String       @id @default(uuid())
  name              String
  primaryMuscle     MuscleGroup
  secondaryMuscles  MuscleGroup[]
  equipment         Equipment?
  category          ExerciseCategory
  imageUrls         String[]
  translations      ExerciseTranslation[]

  @@map("exercises")
}

/// Localized exercise names. `Exercise.name` stays as the canonical English
/// name from free-exercise-db; every exercise has one row per supported locale.
model ExerciseTranslation {
  id         String   @id @default(uuid())
  exerciseId String
  locale     Locale
  /// Collated with ICU in the migration so accents/case sort naturally.
  name       String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, locale])
  @@index([locale, name])
  @@map("exercise_translations")
}

enum Locale {
  es
  en
}

enum MuscleGroup {
  abdominals
  abductors
  adductors
  biceps
  calves
  chest
  forearms
  glutes
  hamstrings
  lats
  lower_back
  middle_back
  neck
  quadriceps
  shoulders
  traps
  triceps
}

enum Equipment {
  barbell
  dumbbell
  kettlebells
  machine
  cable
  body_only
  bands
  medicine_ball
  exercise_ball
  foam_roll
  e_z_curl_bar
  other
}

enum ExerciseCategory {
  strength
  stretching
  plyometrics
  strongman
  powerlifting
  cardio
  olympic_weightlifting
}
